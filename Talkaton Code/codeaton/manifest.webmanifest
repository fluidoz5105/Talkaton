{
  "id": "/codeaton/app",
  "name": "Codeaton by Talkaton",
  "short_name": "Codeaton",
  "description": "A local-first AI coding workspace with reviewable edits.",
  "start_url": "/codeaton/app",
  "scope": "/codeaton/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#080909",
  "theme_color": "#09090b",
  "categories": ["developer", "productivity"],
  "icons": [
    { "src": "/codeaton/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any maskable" },
    { "src": "/codeaton/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any maskable" },
    { "src": "/codeaton/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any maskable" }
  ],
  "shortcuts": [
    { "name": "Open workspace", "short_name": "Open folder", "url": "/codeaton/app?open=1" },
    { "name": "New agent task", "short_name": "New task", "url": "/codeaton/app?task=1" }
  ]
}
