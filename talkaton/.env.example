# Server-only API keys. Copy this file to .env.local for local development.
# Never commit real key values.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=

# Free and Guest text uses Ollama; paid plans also use it after their allowance.
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_FALLBACK_MODEL=gemma4:31b

# Stripe subscriptions. Live charging requires a live secret and live-mode
# recurring Price IDs; test keys and test Price IDs keep checkout in test mode.
STRIPE_SECRET_KEY=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
STRIPE_PORTAL_CONFIGURATION_ID=
PUBLIC_BILLING_URL=https://subscriptions.talkaton.org

# Local development only. Production always rejects Stripe test-mode keys.
ALLOW_STRIPE_TEST_MODE=false

# Server-only Supabase access for developer keys and OAuth token storage.
# Use the project service-role key; never expose it in browser code.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# Generate independent random values of at least 32 characters for each secret.
TALKATON_API_KEY_PEPPER=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_STATE_SECRET=
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_OAUTH_REDIRECT_URI=https://talkaton.org/api/github-oauth?action=callback

# Optional comma-separated accounts that should receive Beta access.
BETA_APPROVED_EMAILS=kantertal1@gmail.com,supportaton@gmail.com

# Resend + signed Supabase Send Email hook. Server-only; never NEXT_PUBLIC_.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SEND_EMAIL_HOOK_SECRET=

# Stable independent secret for usage identity hashes.
GUEST_USAGE_SECRET=
